[node name="NoteEnv1" parent="." unique_id=242742007 instance=ExtResource("5")]
position = Vector2(200, 620)
examine_text = "На притолоке вырезаны слова, уже потемневшие: «Эбэ, хаан буолуой». Чтобы духи предков берегли этот порог."
interaction_text = "Осмотреть притолоку"

[node name="NoteEnv5" parent="." unique_id=242742008 instance=ExtResource("5")]
position = Vector2(700, 580)
examine_text = "Дом. Собака. Солнце. Буквами снизу — неровно: «Кыдаана»."
interaction_text = "Осмотреть рисунок"

[node name="Damper" parent="." unique_id=242742009 instance=ExtResource("5")]
position = Vector2(1900, 620)
